  "contents": [
    {
      "id": "content_01_aero_support",
      "paragraphs": [
        {"id": "p01", "tokens": 27, "text": "The Atlas night support desk moved to Bay 7 after the January ventilation review."},
        {"id": "p21", "tokens": 31, "text": "A retired memo says the Atlas night desk moved to Bay 5, but that memo was withdrawn."},
        {"id": "p06", "tokens": 29, "text": "The sensor cart must be staged beside Hangar 2 during winter calibration."},
        {"id": "p33", "tokens": 30, "text": "Hangar 3 accepts overnight staging only for paint-shop air filters, not Atlas calibration carts."},
        {"id": "p02", "tokens": 28, "text": "Mira Patel is the duty lead who approves urgent avionics replacement requests for Atlas."},
        {"id": "p17", "tokens": 33, "text": "A contractor guide lists 07:15 as a calibration start time, but it applies to Orion."},
        {"id": "p10", "tokens": 29, "text": "When the aft temperature warning appears, left harness inspection is assigned to structural."},
        {"id": "p26", "tokens": 31, "text": "A superseded training note says urgent avionics replacements are stored in Cage C."},
        {"id": "p05", "tokens": 28, "text": "The winter calibration window begins at 06:30 before the first engine run."},
        {"id": "p38", "tokens": 27, "text": "The aft temperature warning should not be routed to the electrical corrosion queue."},
        {"id": "p03", "tokens": 27, "text": "Approved urgent avionics replacements are stored in Cage D."},
        {"id": "p18", "tokens": 30, "text": "The sensor cart carries tablet mounts and a red charging cable under its tray."},
        {"id": "p08", "tokens": 28, "text": "The previous evening battery health printout is filed in Binder Blue."},
        {"id": "p29", "tokens": 32, "text": "Cabin panel reviews are logged in the white trim notebook, not the amber ledger."},
        {"id": "p04", "tokens": 29, "text": "Cage D opens only after the secure tool room records Mira Patel's approval code."},
        {"id": "p15", "tokens": 29, "text": "The general parts cabinet contains fasteners, cable labels, and cleaning cloths."},
        {"id": "p12", "tokens": 27, "text": "Shift controller Dev Rao reviews the amber maintenance ledger."},
        {"id": "p34", "tokens": 31, "text": "Binder Green contains fueling checklists and does not contain battery health printouts."},
        {"id": "p07", "tokens": 27, "text": "Hangar 2 staging requires the previous evening battery health printout."},
        {"id": "p22", "tokens": 30, "text": "The electrical team reviews right-harness corrosion alerts, not left-harness insulation rubs."},
        {"id": "p11", "tokens": 28, "text": "Structural inspections must be logged in the amber maintenance ledger before release."},
        {"id": "p35", "tokens": 33, "text": "A facilities bulletin mentions Bay 7 catering deliveries unrelated to the night desk."},
        {"id": "p30", "tokens": 28, "text": "Dev Rao is not responsible for catering, hydraulic seal approval, or Orion calibration."},
        {"id": "p16", "tokens": 30, "text": "Bay 4 still hosts the legacy simulator desk and gets misdirected support calls."},
        {"id": "p09", "tokens": 30, "text": "Atlas field reports link the aft temperature warning to insulation rubbing the left harness."},
        {"id": "p20", "tokens": 30, "text": "A spare binder shelf label near the fuel records cabinet also says amber."},
        {"id": "p14", "tokens": 32, "text": "A parts summary mentions Mira Patel and Cage D but says she approves hydraulic seals."},
        {"id": "p24", "tokens": 29, "text": "Dev Rao signs the release sheet after the structural team entry appears."},
        {"id": "p27", "tokens": 27, "text": "The secure tool room records approval codes for restricted cages."},
        {"id": "p28", "tokens": 29, "text": "Ground power files Binder Blue after the battery cart is returned."},
        {"id": "p13", "tokens": 31, "text": "The old Bay 5 help-desk sign remains on a storage door near the simulator."},
        {"id": "p19", "tokens": 29, "text": "Hangar 2 has limited power during winter calibration, so staging must be early."},
        {"id": "p23", "tokens": 30, "text": "Torque kits are tracked by the secure tool room but are not stored in Cage D."},
        {"id": "p25", "tokens": 31, "text": "Routine avionics labels are kept in the general parts cabinet, not the restricted cage."},
        {"id": "p31", "tokens": 29, "text": "The ground power team owns the battery health printout process for Atlas staging."},
        {"id": "p32", "tokens": 30, "text": "The rollout coordinator checks that the sensor cart has arrived before calibration begins."},
        {"id": "p36", "tokens": 30, "text": "A duplicate aft-warning note says cold starts can make insulation rub the left harness."},
        {"id": "p37", "tokens": 31, "text": "A clerk may shelve the amber ledger beside fuel records after Dev Rao reviews it."},
        {"id": "p39", "tokens": 28, "text": "Release paperwork is held until the amber ledger contains the structural inspection entry."},
        {"id": "p40", "tokens": 29, "text": "Urgent replacement requests are marked red before they reach Mira Patel for approval."}
      ],
